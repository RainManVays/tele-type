# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

.idea/

# Compiled app binary
/tele-type

# TeleType-generated encoded/offset files (produced by loading a file in-app)
*.base64.txt
*.base85.txt
*.base91.txt
*.base122.txt
*.offset

# Wails build scaffolding for platforms this app can't target (no
# other-window keyboard injection concept on mobile/containers)
/build/android/
/build/ios/
/build/docker/
